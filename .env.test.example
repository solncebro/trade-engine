# Binance Demo Trading
# Create keys at: https://demo.binance.com → Profile → API Management
# One key works for both spot and futures
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET_KEY=

# Bybit Demo Trading
# Create keys at: https://demo.bybit.com → Profile → API Management
# One key works for both spot and futures
# The key is bound to an IP allow-list: add the machine that runs the checks, or every signed
# call answers "10010: Unmatched IP" while the public ones keep working
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_SECRET_KEY=

# OKX Demo Trading
# Create keys at: https://www.okx.com → Demo trading → API
# Three variables, not two: OKX asks for a passphrase of your own when the key is created,
# and signs every request with it. Without OKX_DEMO_PASSPHRASE the checks skip themselves.
# One key works for both spot and swap; demo is selected by the x-simulated-trading header,
# there is no separate host.
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
